# Climate Data Store (CDS) credentials for the real-data path of the
# spatial-extremes tutorials. Export these in your shell, put them in a `.env`
# file (gitignored), or use `~/.cdsapirc`. Requires a free CDS account and
# acceptance of the in-situ land dataset licence:
#   https://cds.climate.copernicus.eu/datasets/insitu-observations-surface-land
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-key-here

# Optional: redirect the cached archive elsewhere
# (default: docs/tutorials/spatial_extremes/data/).
# CDS_INSITU_SCRATCH_ROOT=/path/to/scratch
